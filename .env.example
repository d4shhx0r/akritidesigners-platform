# Akritidesigners Environment Configuration
# Copy this file to .env.local for local development

# Base Site URL
NEXT_PUBLIC_SITE_URL=https://akritidesigners-platform.vercel.app

# Supabase Database Configuration (Optional - for storing project inquiries)
# Find these in your Supabase project settings -> API: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional Transactional Email Integration (e.g. Resend, Postmark, SendGrid)
# RESEND_API_KEY=re_123456789
# STUDIO_NOTIFICATION_EMAIL=inquiries@akritidesigners.com
